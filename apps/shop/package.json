{
  "name": "@portfolio/shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/dev.ts",
    "relay": "relay-compiler",
    "schema:pull": "node scripts/pull-schema.ts",
    "build": "pnpm relay && vite build --ssrManifest --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@portfolio/ssr": "workspace:*",
    "@portfolio/ui": "workspace:*",
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-relay": "^21.0.1",
    "react-router": "^8.5.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@shopify/hydrogen-react": "^2026.4.4",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "babel-plugin-relay": "^21.0.1",
    "graphql": "^16.15.0",
    "relay-compiler": "^21.0.1",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
