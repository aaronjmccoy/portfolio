# Shopify Storefront API. Store handle from the admin URL (admin.shopify.com/store/<handle>).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Headless channel > storefront > Storefront API: the public token (32 hex chars) ships to the browser;
# the private token (shpat_...) is used only on the server (SSR, schema pull). Either works server-side.
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
# The Admin API token for the importer lives in tools/catalog/.env, never here.
# Server
PORT=3000
METRICS_BIND=127.0.0.1
