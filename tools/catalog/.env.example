# Shopify Admin API, server-side only; never shipped to a browser.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2026-10
# Dev Dashboard app (since 2026 all custom apps are made there): the tool exchanges the
# client id + secret for a 24-hour Admin token with the client credentials grant at run time.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: a long-lived Admin token, if you have one. Takes precedence when set.
SHOPIFY_ADMIN_TOKEN=
